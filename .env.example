# MatchSense AI - example environment file.
# Copy to .env and fill in locally. NEVER commit .env (it is git-ignored).

# --- Application ---
MATCHSENSE_DATA_DIR=data
MATCHSENSE_SEED=20261023
MATCHSENSE_LOG_LEVEL=INFO

# --- Narrative provider ---
# "template"  -> deterministic, offline, no credentials required (default)
# "azure_openai" -> requires the four values below
MATCHSENSE_NARRATIVE_PROVIDER=template

# --- Azure OpenAI / Foundry (optional, only used when provider=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
